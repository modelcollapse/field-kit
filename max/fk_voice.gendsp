          "code": "note_in_scale(note, scaleMask) {\n    return floor(scaleMask / pow(2, note % 12)) % 2;\n}\n\nsnap_speed(speed, scale) {\n    // Shift the 0.125x to 4x range up three octaves for non-negative note indices.\n    semitones = 12 * log(clamp(speed, 0.125, 4)) / log(2) + 36;\n    nearest = floor(semitones + 0.5);\n    if (scale > 1) {\n        // A set bit marks an allowed semitone above the tonic.\n        scaleMask = 2741; // Major\n        if (scale == 3) {\n            scaleMask = 1453; // Natural minor\n        } else if (scale == 4) {\n            scaleMask = 1709; // Dorian\n        } else if (scale == 5) {\n            scaleMask = 661; // Major pentatonic\n        } else if (scale == 6) {\n            scaleMask = 1193; // Minor pentatonic\n        }\n\n        if (!note_in_scale(nearest, scaleMask)) {\n            // These scales leave at most two consecutive semitones out.\n            lower = nearest - 1;\n            upper = nearest + 1;\n            lower = lower - (1 - note_in_scale(lower, scaleMask));\n            upper = upper + (1 - note_in_scale(upper, scaleMask));\n            nearest = semitones - lower < upper - semitones ? lower : upper;\n        }\n    }\n    return pow(2, (nearest - 36) / 12);\n}\n\nBuffer source;\n\nHistory legPhase(0);\nHistory legReverse(0);\nHistory wasPlaying(0);\nHistory gateMemory(0);\n\nHistory startMemory(0);\nHistory endMemory(1);\nHistory rateMemory(1);\nHistory fadeMemory(12);\nHistory driveMemory(0);\nHistory filterMemory(0);\nHistory levelMemory(0);\nHistory panMemory(0);\n\nHistory modeMemory(0);\nHistory correctionLeft(0);\nHistory correctionRight(0);\nHistory mixedLeftMemory(0);\nHistory mixedRightMemory(0);\nHistory poleLeft(0);\nHistory poleRight(0);\n\nframeCount = dim(source);\nsourceRate = in11 > 0 ? in11 : samplerate;\nplaying = (in10 >= 0.5) && (frameCount >= 2);\nonset = playing && !wasPlaying;\ngate = clamp(gateMemory + (playing ? 1 : -1) * 200 / samplerate, 0, 1);\nrolling = playing || (gate > 0);\n\ncontrolSlew = 1 - exp(-100 / samplerate);\nedgeSlew = 1 - exp(-50 / samplerate);\nsmoothControls = rolling && !onset;\ncontrolMix = smoothControls ? controlSlew : 1;\nedgeMix = smoothControls ? edgeSlew : 1;\n\nstartNorm = mix(startMemory, clamp(in1, 0, 1), edgeMix);\nendNorm = mix(endMemory, clamp(in2, 0, 1), edgeMix);\nrateTarget = clamp(in3, 0.01, 8);\npitchScale = clamp(floor(in12 + 0.5), 0, 6);\nif (pitchScale > 0) {\n    rateTarget = snap_speed(rateTarget, pitchScale);\n}\nrateScale = mix(rateMemory, rateTarget, controlMix);\nfadeMs = mix(fadeMemory, clamp(in5, 0, 500), controlMix);\ndriveAmt = mix(driveMemory, clamp(in6, 0, 1), controlMix);\nfilterAmt = mix(filterMemory, clamp(in7, -1, 1), controlMix);\nlevelAmt = mix(levelMemory, clamp(in8, 0, 1), controlMix);\npanAmt = mix(panMemory, clamp(in9, -1, 1), controlMix);\n\nstartMemory = startNorm;\nendMemory = endNorm;\nrateMemory = rateScale;\nfadeMemory = fadeMs;\ndriveMemory = driveAmt;\nfilterMemory = filterAmt;\nlevelMemory = levelAmt;\npanMemory = panAmt;\n\n// Start inclusive, end exclusive. The last readable index is one frame before end.\nusableFrames = max(frameCount, 2);\nminSpan = min(usableFrames, max(2, sourceRate * 0.001));\nregionStart = clamp(min(startNorm, endNorm) * usableFrames, 0, usableFrames - minSpan);\nregionEnd = clamp(max(startNorm, endNorm) * usableFrames, regionStart + minSpan, usableFrames);\nspan = regionEnd - regionStart;\nlastReadable = regionEnd - 1;\nlastPhase = (span - 1) / span;\n\nplayMode = clamp(floor(in4 + 0.5), 0, 2);\npingPong = playMode == 2;\nreverseNow = pingPong ? legReverse : (playMode == 1);\nposition = legPhase;\n\nif (onset || !rolling) {\n    position = 0;\n    reverseNow = playMode == 1;\n} else if (reverseNow != legReverse) {\n    // A manual reversal keeps the read index at the point already playing.\n    position = clamp(lastPhase - position, 0, lastPhase);\n}\n\n// At a seam, overlap the end of this leg with the beginning of the next leg.\n// The next leg resumes beyond the part already heard during the overlap.\nstepFrames = rateScale * sourceRate / samplerate;\nfadeFrames = min(span * 0.45, fadeMs * rateScale * sourceRate * 0.001);\nfadePhase = fadeFrames / span;\ncycleSpan = 1 - fadePhase;\noffset = position * span;\nincomingOffset = max(0, position - cycleSpan) * span;\nreverseNextLeg = pingPong ? (1 - reverseNow) : reverseNow;\n\nprimaryIndex = clamp(reverseNow ? lastReadable - offset : regionStart + offset, regionStart, lastReadable);\nincomingIndex = clamp(reverseNextLeg ? lastReadable - incomingOffset : regionStart + incomingOffset, regionStart, lastReadable);\nfadePos = clamp(incomingOffset / max(fadeFrames, 0.000001), 0, 1);\nfadeWeight = fadePos * fadePos * (3 - 2 * fadePos);\n\nnextPosition = position + stepFrames / span;\nif (nextPosition >= 1) {\n    crossedLegs = 1 + floor((nextPosition - 1) / cycleSpan);\n    nextPosition = nextPosition - crossedLegs * cycleSpan;\n    if (pingPong && ((crossedLegs % 2) == 1)) {\n        reverseNow = 1 - reverseNow;\n    }\n}\n\nlegPhase = rolling ? nextPosition : 0;\nlegReverse = rolling ? reverseNow : (playMode == 1);\nwasPlaying = playing;\ngateMemory = gate;\n\n// Clamp the right read to the first channel for a mono source.\nreadChannel = clamp(channels(source) - 1, 0, 1);\nprimaryLeft = peek(source, primaryIndex, 0, interp=\"linear\", boundmode=\"clamp\");\nprimaryRight = peek(source, primaryIndex, readChannel, interp=\"linear\", boundmode=\"clamp\");\nincomingLeft = peek(source, incomingIndex, 0, interp=\"linear\", boundmode=\"clamp\");\nincomingRight = peek(source, incomingIndex, readChannel, interp=\"linear\", boundmode=\"clamp\");\nmixedLeft = mix(primaryLeft, incomingLeft, fadeWeight);\nmixedRight = mix(primaryRight, incomingRight, fadeWeight);\n\n// A mode change can interrupt an overlap. Decay the difference from the last sample.\nchangeMode = playMode != modeMemory;\noffsetLeft = changeMode ? mixedLeftMemory - mixedLeft : correctionLeft;\noffsetRight = changeMode ? mixedRightMemory - mixedRight : correctionRight;\noffsetLeft = smoothControls ? offsetLeft : 0;\noffsetRight = smoothControls ? offsetRight : 0;\nmixedLeft = mixedLeft + offsetLeft;\nmixedRight = mixedRight + offsetRight;\n\ncorrectionDecay = exp(-400 / samplerate);\ncorrectionLeft = offsetLeft * correctionDecay;\ncorrectionRight = offsetRight * correctionDecay;\nmixedLeftMemory = mixedLeft;\nmixedRightMemory = mixedRight;\nmodeMemory = playMode;\n\ndriveGain = 1 + 11 * driveAmt;\ndriveWet = min(1, driveAmt * 3);\ndriveNorm = 1 / tanh(driveGain);\ndrivenLeft = mix(mixedLeft, tanh(mixedLeft * driveGain) * driveNorm, driveWet);\ndrivenRight = mix(mixedRight, tanh(mixedRight * driveGain) * driveNorm, driveWet);\n\n// Low-pass on the negative side, high-pass on the positive side, flat at center.\nlowPass = filterAmt < 0;\nlowCut = min(18000, samplerate * 0.45) * pow(0.01, -filterAmt);\nhighCut = min(7500, samplerate * 0.45) * pow(0.003333333333, 1 - filterAmt);\ncutoff = lowPass ? lowCut : highCut;\npoleMix = 1 - exp(-twopi * cutoff / samplerate);\nlowLeft = mix(poleLeft, drivenLeft, poleMix);\nlowRight = mix(poleRight, drivenRight, poleMix);\npoleLeft = rolling ? lowLeft : 0;\npoleRight = rolling ? lowRight : 0;\nfilterWet = min(1, abs(filterAmt) * 10);\nfilteredLeft = mix(drivenLeft, lowPass ? lowLeft : drivenLeft - lowLeft, filterWet);\nfilteredRight = mix(drivenRight, lowPass ? lowRight : drivenRight - lowRight, filterWet);\n\n// Center preserves stereo. Toward either edge, crossfeed the far channel.\npanAngle = abs(panAmt) * pi * 0.5;\npanCross = sin(panAngle);\npanFar = cos(panAngle);\npanNorm = 1 / sqrt(1 + panCross);\npannedLeft = panAmt < 0 ? filteredLeft + filteredRight * panCross : filteredLeft * panFar;\npannedRight = panAmt > 0 ? filteredRight + filteredLeft * panCross : filteredRight * panFar;\n\nout1 = pannedLeft * panNorm * levelAmt * gate;\nout2 = pannedRight * panNorm * levelAmt * gate;\nout3 = primaryIndex / max(1, frameCount - 1);\n\n// Publish applied controls in the same units as the signal inlets.\nout4 = frameCount >= 2 ? regionStart / usableFrames : startNorm;\nout5 = frameCount >= 2 ? regionEnd / usableFrames : endNorm;\nout6 = rateScale;\nout7 = playMode;\nout8 = frameCount >= 2 ? 1000 * fadeFrames / (rateScale * sourceRate) : fadeMs;\nout9 = driveAmt;\nout10 = filterAmt;\nout11 = levelAmt;\nout12 = panAmt;\n"
        }
