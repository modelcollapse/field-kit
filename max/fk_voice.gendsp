          "code": "note_in_scale(note, scaleMask) {\n    return floor(scaleMask / pow(2, note % 12)) % 2;\n}\n\nsnap_speed(speed, scale) {\n    // Shift the 0.125x to 4x range up three octaves for non-negative note indices.\n    semitones = 12 * log(clamp(speed, 0.125, 4)) / log(2) + 36;\n    nearest = floor(semitones + 0.5);\n    if (scale > 1) {\n        // A set bit marks an allowed semitone above the tonic.\n        scaleMask = 2741; // Major\n        if (scale == 3) {\n            scaleMask = 1453; // Natural minor\n        } else if (scale == 4) {\n            scaleMask = 1709; // Dorian\n        } else if (scale == 5) {\n            scaleMask = 661; // Major pentatonic\n        } else if (scale == 6) {\n            scaleMask = 1193; // Minor pentatonic\n        }\n\n        if (!note_in_scale(nearest, scaleMask)) {\n            // These scales leave at most two consecutive semitones out.\n            lower = nearest - 1;\n            upper = nearest + 1;\n            lower = lower - (1 - note_in_scale(lower, scaleMask));\n            upper = upper + (1 - note_in_scale(upper, scaleMask));\n            nearest = semitones - lower < upper - semitones ? lower : upper;\n        }\n    }\n    return pow(2, (nearest - 36) / 12);\n}\n\nrender_voice(source, startCtl, endCtl, rateCtl, modeCtl, fadeCtl, driveCtl, filterCtl, levelCtl, panCtl, runCtl, sourceRateCtl, scaleCtl, revisionCtl, mixerCtl, speedCtl, matchCtl, restart) {\n    History legPhase(0);\n    History legReverse(0);\n    History wasPlaying(0);\n    History gateMemory(0);\n    History waveRevision(0);\n    History editGateMemory(1);\n\n    History startMemory(0);\n    History endMemory(1);\n    History rateMemory(1);\n    History pitchReferenceMemory(1);\n    History fadeMemory(12);\n    History driveMemory(0);\n    History filterMemory(0);\n    History levelMemory(0);\n    History panMemory(0);\n\n    History modeMemory(0);\n    History correctionLeft(0);\n    History correctionRight(0);\n    History mixedLeftMemory(0);\n    History mixedRightMemory(0);\n    History poleLeft(0);\n    History poleRight(0);\n\n    frameCount = dim(source);\n    sourceRate = sourceRateCtl > 0 ? sourceRateCtl : samplerate;\n    playing = (runCtl >= 0.5) && (frameCount >= 2);\n    onset = playing && (restart || (!wasPlaying && gateMemory <= 0));\n    gate = restart ? playing : clamp(gateMemory + (playing ? 1 : -1) / (samplerate * 0.016), 0, 1);\n    transportGain = gate * gate * (3 - 2 * gate);\n    rolling = playing || (gate > 0);\n\n    controlSlew = 1 - exp(-100 / samplerate);\n    edgeSlew = 1 - exp(-50 / samplerate);\n    smoothControls = rolling && !onset;\n    controlMix = smoothControls ? controlSlew : 1;\n    // Commit manual region changes at silence without sweeping the read index.\n    editPending = revisionCtl != waveRevision;\n    editGate = smoothControls ? clamp(editGateMemory + (editPending ? -1 : 1) / (samplerate * 0.012), 0, 1) : 1;\n    commitEdit = smoothControls && editPending && (editGate <= 0);\n    if (!smoothControls || commitEdit) {\n        waveRevision = revisionCtl;\n    }\n    editGateMemory = editGate;\n    editGain = editGate * editGate * (3 - 2 * editGate);\n    edgeMix = !smoothControls || commitEdit ? 1 : (editPending ? 0 : edgeSlew);\n\n    startNorm = mix(startMemory, clamp(startCtl, 0, 1), edgeMix);\n    endNorm = mix(endMemory, clamp(endCtl, 0, 1), edgeMix);\n    rateTarget = clamp(rateCtl, 0.01, 8);\n    pitchScale = clamp(floor(scaleCtl + 0.5), 0, 6);\n    if (pitchScale > 0) {\n        rateTarget = snap_speed(rateTarget, pitchScale);\n    }\n    // Scale the snapped local speeds together, or match all four to one absolute rate.\n    globalSpeed = clamp(speedCtl, 0.5, 2);\n    pitchReference = matchCtl >= 0.5 ? 1 : rateTarget;\n    rateTarget = pitchReference * globalSpeed;\n    rateScale = mix(rateMemory, rateTarget, controlMix);\n    pitchReferenceRate = mix(pitchReferenceMemory, pitchReference, controlMix);\n    pitchReferenceMemory = pitchReferenceRate;\n    fadeMs = mix(fadeMemory, clamp(fadeCtl, 0, 500), controlMix);\n    driveAmt = mix(driveMemory, clamp(driveCtl, 0, 1), controlMix);\n    filterAmt = mix(filterMemory, clamp(filterCtl, -1, 1), controlMix);\n    levelAmt = mix(levelMemory, clamp(levelCtl, 0, 1), controlMix);\n    panAmt = mix(panMemory, clamp(panCtl, -1, 1), controlMix);\n\n    startMemory = startNorm;\n    endMemory = endNorm;\n    rateMemory = rateScale;\n    fadeMemory = fadeMs;\n    driveMemory = driveAmt;\n    filterMemory = filterAmt;\n    levelMemory = levelAmt;\n    panMemory = panAmt;\n\n    // Start inclusive, end exclusive. The last readable index is one frame before end.\n    usableFrames = max(frameCount, 2);\n    minSpan = min(usableFrames, max(2, sourceRate * 0.001));\n    regionStart = clamp(min(startNorm, endNorm) * usableFrames, 0, usableFrames - minSpan);\n    regionEnd = clamp(max(startNorm, endNorm) * usableFrames, regionStart + minSpan, usableFrames);\n    span = regionEnd - regionStart;\n    lastReadable = regionEnd - 1;\n    lastPhase = (span - 1) / span;\n\n    playMode = clamp(floor(modeCtl + 0.5), 0, 2);\n    pingPong = playMode == 2;\n    reverseNow = pingPong ? legReverse : (playMode == 1);\n    position = legPhase;\n\n    if (onset || !rolling) {\n        position = 0;\n        reverseNow = playMode == 1;\n    } else if (reverseNow != legReverse) {\n        // A manual reversal keeps the read index at the point already playing.\n        position = clamp(lastPhase - position, 0, lastPhase);\n    }\n\n    // At a seam, overlap the end of this leg with the beginning of the next leg.\n    // The next leg resumes beyond the part already heard during the overlap.\n    stepFrames = rateScale * sourceRate / samplerate;\n    fadeFrames = min(span * 0.45, fadeMs * rateScale * sourceRate * 0.001);\n    fadePhase = fadeFrames / span;\n    cycleSpan = 1 - fadePhase;\n    offset = position * span;\n    incomingOffset = max(0, position - cycleSpan) * span;\n    reverseNextLeg = pingPong ? (1 - reverseNow) : reverseNow;\n\n    primaryIndex = clamp(reverseNow ? lastReadable - offset : regionStart + offset, regionStart, lastReadable);\n    incomingIndex = clamp(reverseNextLeg ? lastReadable - incomingOffset : regionStart + incomingOffset, regionStart, lastReadable);\n    fadePos = clamp(incomingOffset / max(fadeFrames, 0.000001), 0, 1);\n    fadeWeight = fadePos * fadePos * (3 - 2 * fadePos);\n\n    nextPosition = position + stepFrames / span;\n    atSeam = playing && nextPosition >= 1;\n    if (nextPosition >= 1) {\n        crossedLegs = 1 + floor((nextPosition - 1) / cycleSpan);\n        nextPosition = nextPosition - crossedLegs * cycleSpan;\n        if (pingPong && ((crossedLegs % 2) == 1)) {\n            reverseNow = 1 - reverseNow;\n        }\n    }\n\n    legPhase = rolling ? nextPosition : 0;\n    legReverse = rolling ? reverseNow : (playMode == 1);\n    wasPlaying = playing;\n    gateMemory = gate;\n\n    // Clamp the right read to the first channel for a mono source.\n    readChannel = clamp(channels(source) - 1, 0, 1);\n    primaryLeft = peek(source, primaryIndex, 0, interp=\"linear\", boundmode=\"clamp\");\n    primaryRight = peek(source, primaryIndex, readChannel, interp=\"linear\", boundmode=\"clamp\");\n    incomingLeft = peek(source, incomingIndex, 0, interp=\"linear\", boundmode=\"clamp\");\n    incomingRight = peek(source, incomingIndex, readChannel, interp=\"linear\", boundmode=\"clamp\");\n    mixedLeft = mix(primaryLeft, incomingLeft, fadeWeight);\n    mixedRight = mix(primaryRight, incomingRight, fadeWeight);\n\n    // A mode change can interrupt an overlap. Decay the difference from the last sample.\n    changeMode = playMode != modeMemory;\n    offsetLeft = changeMode ? mixedLeftMemory - mixedLeft : correctionLeft;\n    offsetRight = changeMode ? mixedRightMemory - mixedRight : correctionRight;\n    offsetLeft = smoothControls ? offsetLeft : 0;\n    offsetRight = smoothControls ? offsetRight : 0;\n    mixedLeft = mixedLeft + offsetLeft;\n    mixedRight = mixedRight + offsetRight;\n\n    correctionDecay = exp(-400 / samplerate);\n    correctionLeft = offsetLeft * correctionDecay;\n    correctionRight = offsetRight * correctionDecay;\n    mixedLeftMemory = mixedLeft;\n    mixedRightMemory = mixedRight;\n    modeMemory = playMode;\n\n    driveGain = 1 + 11 * driveAmt;\n    driveWet = min(1, driveAmt * 3);\n    driveNorm = 1 / tanh(driveGain);\n    drivenLeft = mix(mixedLeft, tanh(mixedLeft * driveGain) * driveNorm, driveWet);\n    drivenRight = mix(mixedRight, tanh(mixedRight * driveGain) * driveNorm, driveWet);\n\n    // Low-pass on the negative side, high-pass on the positive side, flat at center.\n    lowPass = filterAmt < 0;\n    lowCut = min(18000, samplerate * 0.45) * pow(0.01, -filterAmt);\n    highCut = min(7500, samplerate * 0.45) * pow(0.003333333333, 1 - filterAmt);\n    cutoff = lowPass ? lowCut : highCut;\n    poleMix = 1 - exp(-twopi * cutoff / samplerate);\n    lowLeft = mix(restart ? 0 : poleLeft, drivenLeft, poleMix);\n    lowRight = mix(restart ? 0 : poleRight, drivenRight, poleMix);\n    poleLeft = rolling ? lowLeft : 0;\n    poleRight = rolling ? lowRight : 0;\n    filterWet = min(1, abs(filterAmt) * 10);\n    filteredLeft = mix(drivenLeft, lowPass ? lowLeft : drivenLeft - lowLeft, filterWet);\n    filteredRight = mix(drivenRight, lowPass ? lowRight : drivenRight - lowRight, filterWet);\n\n    // Center preserves stereo. Toward either edge, crossfeed the far channel.\n    panAngle = abs(panAmt) * pi * 0.5;\n    panCross = sin(panAngle);\n    panFar = cos(panAngle);\n    panNorm = 1 / sqrt(1 + panCross);\n    pannedLeft = panAmt < 0 ? filteredLeft + filteredRight * panCross : filteredLeft * panFar;\n    pannedRight = panAmt > 0 ? filteredRight + filteredLeft * panCross : filteredRight * panFar;\n\n    left = pannedLeft * panNorm * levelAmt * transportGain * editGain * mixerCtl;\n    right = pannedRight * panNorm * levelAmt * transportGain * editGain * mixerCtl;\n    playhead = primaryIndex / max(1, frameCount - 1);\n\n    // Publish applied controls in the same units as the signal inlets.\n    start = frameCount >= 2 ? regionStart / usableFrames : startNorm;\n    end = frameCount >= 2 ? regionEnd / usableFrames : endNorm;\n    rate = rateScale;\n    mode = playMode;\n    fade = frameCount >= 2 ? 1000 * fadeFrames / (rateScale * sourceRate) : fadeMs;\n    drive = driveAmt;\n    filter = filterAmt;\n    level = levelAmt;\n    pan = panAmt;\n\n    ratio = pitchReferenceRate / rateScale;return left, right, playhead, start, end, rate, mode, fade, drive, filter, level, pan, ratio, atSeam;\n}\n\nBuffer source;\nParam global_speed(1);\nParam match_speed(0);\n// Even commands latch the old controls. Odd commands commit at the next seam.\nParam scene_command(0);\nHistory sceneId(0);\nHistory sceneState(0);\nHistory activeLane(0);\nHistory previousSeam(0);\nHistory fadePosition(0);\n\nHistory old_startCtl(0);\nHistory old_endCtl(0);\nHistory old_rateCtl(0);\nHistory old_modeCtl(0);\nHistory old_fadeCtl(0);\nHistory old_driveCtl(0);\nHistory old_filterCtl(0);\nHistory old_levelCtl(0);\nHistory old_panCtl(0);\nHistory old_scaleCtl(0);\nHistory old_revisionCtl(0);\nHistory old_mixerCtl(0);\nHistory old_echoCtl(0);\nHistory old_roomCtl(0);\nHistory old_speedCtl(0);\nHistory old_matchCtl(0);\n\ncommand = floor(scene_command + 0.5);\ncue = max(0, floor(command / 2));\nstate = sceneState;\nlane = activeLane;\nprogress = fadePosition;\nrunning = in10 >= 0.5 && dim(source) >= 2;\narm = cue > 0 && cue != sceneId;\nif (arm) {\n    state = 1;\n    old_startCtl = in1;\n    old_endCtl = in2;\n    old_rateCtl = in3;\n    old_modeCtl = in4;\n    old_fadeCtl = in5;\n    old_driveCtl = in6;\n    old_filterCtl = in7;\n    old_levelCtl = in8;\n    old_panCtl = in9;\n    old_scaleCtl = in12;\n    old_revisionCtl = in13;\n    old_mixerCtl = in14;\n    old_echoCtl = in15;\n    old_roomCtl = in16;\n    old_speedCtl = global_speed;\n    old_matchCtl = match_speed;\n} else if (command < 0 || (cue == 0 && state != 1 && state != 2)) {\n    state = 0;\n}\n\n// Stop/cancel can release immediately, with the same smooth tail. Stopped\n// voices never wait for a seam that cannot arrive.\nhandoff = state == 1 && (command == 0 || (command % 2 == 1 && (!running || previousSeam)));\nif (handoff) {\n    lane = 1 - lane;\n    progress = 0;\n    state = 2;\n}\nfading = state == 2;\nholdA = (state == 1 && lane == 0) || (fading && lane == 1);\nholdB = (state == 1 && lane == 1) || (fading && lane == 0);\nleftA, rightA, playheadA, startA, endA, rateA, modeA, fadeA, driveA, filterA, levelA, panA, ratioA, seamA = render_voice(\n    source,\n    holdA ? old_startCtl : in1,\n    holdA ? old_endCtl : in2,\n    holdA ? old_rateCtl : in3,\n    holdA ? old_modeCtl : in4,\n    holdA ? old_fadeCtl : in5,\n    holdA ? old_driveCtl : in6,\n    holdA ? old_filterCtl : in7,\n    holdA ? old_levelCtl : in8,\n    holdA ? old_panCtl : in9,\n    (lane == 0 || fading) ? in10 : 0,\n    in11,\n    holdA ? old_scaleCtl : in12,\n    holdA ? old_revisionCtl : in13,\n    holdA ? old_mixerCtl : in14,\n    holdA ? old_speedCtl : global_speed,\n    holdA ? old_matchCtl : match_speed,\n    handoff && lane == 0\n);\nleftB, rightB, playheadB, startB, endB, rateB, modeB, fadeB, driveB, filterB, levelB, panB, ratioB, seamB = render_voice(\n    source,\n    holdB ? old_startCtl : in1,\n    holdB ? old_endCtl : in2,\n    holdB ? old_rateCtl : in3,\n    holdB ? old_modeCtl : in4,\n    holdB ? old_fadeCtl : in5,\n    holdB ? old_driveCtl : in6,\n    holdB ? old_filterCtl : in7,\n    holdB ? old_levelCtl : in8,\n    holdB ? old_panCtl : in9,\n    (lane == 1 || fading) ? in10 : 0,\n    in11,\n    holdB ? old_scaleCtl : in12,\n    holdB ? old_revisionCtl : in13,\n    holdB ? old_mixerCtl : in14,\n    holdB ? old_speedCtl : global_speed,\n    holdB ? old_matchCtl : match_speed,\n    handoff && lane == 1\n);\n\n// Smooth complementary gains preserve level for identical or correlated loops.\nweight = progress * progress * (3 - 2 * progress);\ngainB = fading ? (lane == 1 ? weight : 1 - weight) : lane;\nout1 = mix(leftA, leftB, gainB);\nout2 = mix(rightA, rightB, gainB);\nout3 = lane == 0 ? playheadA : playheadB;\nout4 = lane == 0 ? startA : startB;\nout5 = lane == 0 ? endA : endB;\nout6 = lane == 0 ? rateA : rateB;\nout7 = lane == 0 ? modeA : modeB;\nout8 = lane == 0 ? fadeA : fadeB;\nout9 = lane == 0 ? driveA : driveB;\nout10 = lane == 0 ? filterA : filterB;\nout11 = lane == 0 ? levelA : levelB;\nout12 = lane == 0 ? panA : panB;\nout13 = mix(ratioA, ratioB, gainB);\nout14 = cue * 4 + state;\nout15 = mix(old_echoCtl, in15, fading ? weight : (state != 1));\nout16 = mix(old_roomCtl, in16, fading ? weight : (state != 1));\n\nif (fading) {\n    progress = min(1, progress + 1 / (samplerate * 0.080));\n    if (progress >= 1) {\n        state = 3;\n    }\n}\nsceneId = cue;\nsceneState = state;\nactiveLane = lane;\npreviousSeam = lane == 0 ? seamA : seamB;\nfadePosition = progress;\n"
        }
